# Pipeline Doctor Environment Configuration

# Backend configuration ('local' uses in-memory queue & store, 'aws' uses SQS & DynamoDB)
BACKEND=local

# LLM Backend ('mock' for local tests, 'bedrock' for Amazon Bedrock)
LLM_BACKEND=mock

# Amazon Bedrock Settings (required when LLM_BACKEND=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1

# Webhook and Security
PD_SECRET=change-me-to-a-secure-secret
